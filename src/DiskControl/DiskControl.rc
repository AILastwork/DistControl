#pragma code_page(65001)

#include "resource.h"
#include <windows.h>

IDI_DISKCONTROL ICON "res\\DiskControl.ico"

IDD_VPN_CREDENTIALS DIALOGEX 0, 0, 280, 142
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DistControl - VPN"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Профиль Windows:", -1, 10, 12, 82, 10
    LTEXT           "", IDC_VPN_PROFILE_NAME, 96, 12, 174, 10
    LTEXT           "Логин VPN:", -1, 10, 39, 82, 10
    EDITTEXT        IDC_VPN_USER_NAME, 96, 35, 174, 14, ES_AUTOHSCROLL
    LTEXT           "Пароль VPN:", -1, 10, 65, 82, 10
    EDITTEXT        IDC_VPN_PASSWORD, 96, 61, 174, 14, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "Данные сохраняются средствами Windows и не записываются в allow.json.", -1, 10, 84, 260, 20
    DEFPUSHBUTTON   "Сохранить", IDOK, 150, 116, 58, 16
    PUSHBUTTON      "Отмена", IDCANCEL, 212, 116, 58, 16
END

IDD_VPN_BULK DIALOGEX 0, 0, 620, 372
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DistControl Admin - сопоставление токенов и VPN"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Пользователь:", -1, 10, 10, 70, 10
    LTEXT           "", IDC_VPN_BULK_USER, 82, 10, 528, 10
    LTEXT           "Поиск:", -1, 10, 32, 48, 10
    EDITTEXT        IDC_VPN_BULK_SEARCH, 60, 28, 330, 16, ES_AUTOHSCROLL
    PUSHBUTTON      "Сброс", IDC_VPN_BULK_CLEAR_SEARCH, 398, 27, 64, 18
    LTEXT           "", IDC_VPN_BULK_COUNT, 470, 32, 140, 10, SS_RIGHT
    CONTROL         "", IDC_VPN_BULK_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 10, 51, 600, 268
    LTEXT           "Нажмите значение в столбце VPN и выберите: Не назначен, БЕЗ VPN или профиль Windows.", -1, 10, 326, 410, 16
    PUSHBUTTON      "Автосопоставить", IDC_VPN_BULK_AUTO_MATCH, 10, 344, 104, 18
    DEFPUSHBUTTON   "Сохранить", IDC_VPN_BULK_SAVE, 430, 344, 84, 18
    PUSHBUTTON      "Закрыть", IDCANCEL, 522, 344, 88, 18
END
