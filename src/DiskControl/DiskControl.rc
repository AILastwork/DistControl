#pragma code_page(65001)

#include "resource.h"
#include <windows.h>
#include <commctrl.h>

IDI_DISKCONTROL ICON "res\\DiskControl.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,8,1,0
 PRODUCTVERSION 0,8,1,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "DistControl\0"
            VALUE "FileDescription", "DistControl\0"
            VALUE "FileVersion", "0.8.1.0\0"
            VALUE "InternalName", "DistControl\0"
            VALUE "OriginalFilename", "DistControl.exe\0"
            VALUE "ProductName", "DistControl\0"
            VALUE "ProductVersion", "0.8.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END

IDD_REPORT_PERIOD DIALOGEX 0, 0, 230, 92
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DistControl Admin - период отчёта"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "С:", -1, 12, 14, 30, 10
    CONTROL         "", IDC_REPORT_FROM, "SysDateTimePick32", DTS_SHORTDATEFORMAT | WS_TABSTOP, 46, 11, 110, 15
    LTEXT           "По:", -1, 12, 38, 30, 10
    CONTROL         "", IDC_REPORT_TO, "SysDateTimePick32", DTS_SHORTDATEFORMAT | WS_TABSTOP, 46, 35, 110, 15
    DEFPUSHBUTTON   "Сформировать", IDOK, 74, 66, 76, 18
    PUSHBUTTON      "Отмена", IDCANCEL, 156, 66, 64, 18
END

IDD_VPN_BULK DIALOGEX 0, 0, 620, 374
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DistControl Admin - сопоставление токенов и VPN"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Пользователь:", -1, 10, 10, 70, 10
    LTEXT           "", IDC_VPN_BULK_USER, 82, 10, 528, 10
    LTEXT           "Поиск:", -1, 10, 32, 48, 10
    EDITTEXT        IDC_VPN_BULK_SEARCH, 60, 28, 330, 16, ES_AUTOHSCROLL
    PUSHBUTTON      "Сброс", IDC_VPN_BULK_CLEAR_SEARCH, 398, 27, 64, 18
    LTEXT           "", IDC_VPN_BULK_COUNT, 470, 32, 140, 10, SS_RIGHT
    CONTROL         "", IDC_VPN_BULK_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 10, 51, 600, 268
    LTEXT           "Нажмите значение в столбце VPN: выберите из списка или вставьте скопированное название (Ctrl+V) и нажмите Enter.", IDC_VPN_BULK_HINT, 10, 323, 600, 18
    PUSHBUTTON      "Автосопоставить", IDC_VPN_BULK_AUTO_MATCH, 10, 346, 104, 18
    PUSHBUTTON      "Без VPN для всех ненастроенных", IDC_VPN_BULK_ALL_DIRECT, 120, 346, 150, 18
    DEFPUSHBUTTON   "Сохранить", IDC_VPN_BULK_SAVE, 430, 346, 84, 18
    PUSHBUTTON      "Закрыть", IDCANCEL, 522, 346, 88, 18
END
